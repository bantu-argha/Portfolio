{"account":"Nakatomi Plaza","tier":"Enterprise","csm":"A. Okafor","arr_usd":555000,"adoption_pct":47.5,"health_score":57.5,"risk_band":"Watch","renewal_in_days":131,"expansion_arr_usd":0}
