const dash=document.getElementById('dash');
const fRisk=document.getElementById('f-risk');
const fCsm=document.getElementById('f-csm');
const fQ=document.getElementById('f-q');
const countEl=document.getElementById('count');
let sortKey='health_score', sortDir=1;

const cols=[
  {k:'account',label:'Account',n:false},
  {k:'tier',label:'Tier',n:false},
  {k:'csm',label:'CSM',n:false},
  {k:'arr_usd',label:'ARR',n:true,fmt:v=>'$'+(Math.round(v/1000))+'K'},
  {k:'adoption_pct',label:'Adopt%',n:true,bar:true},
  {k:'health_score',label:'Health',n:true},
  {k:'risk_band',label:'Risk',n:false,band:true},
  {k:'renewal_in_days',label:'Renew (d)',n:true},
  {k:'expansion_arr_usd',label:'Expand',n:true,fmt:v=>v>0?'$'+Math.round(v/1000)+'K':'—'},
];

function el(t,cls,txt){const e=document.createElement(t);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e;}
function note(msg){const n=el('div','note',msg);n.style.margin='var(--s4)';return n;}

function render(){
  const rb=fRisk.value, cs=fCsm.value, q=fQ.value.trim().toLowerCase();
  let rows=DATA.filter(r=>
    (!rb||r.risk_band===rb)&&(!cs||r.csm===cs)&&(!q||String(r.account).toLowerCase().includes(q))
  );
  const col=cols.find(c=>c.k===sortKey)||cols[5];
  rows.sort((a,b)=>{
    let av=a[sortKey], bv=b[sortKey];
    if(col.n){av=Number(av);bv=Number(bv);return (av-bv)*sortDir;}
    return String(av).localeCompare(String(bv))*sortDir;
  });
  countEl.textContent=rows.length+' / '+DATA.length+' accounts';
  if(!rows.length){dash.replaceChildren(note('No accounts match these filters.'));return;}
  const tbl=el('table','acc');
  const thead=el('thead');const htr=el('tr');
  cols.forEach(c=>{
    const th=el('th',c.n?'n':null);th.scope='col';
    const btn=el('button',null,c.label);
    btn.type='button';
    btn.style.cssText='font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;text-align:inherit;letter-spacing:inherit;text-transform:inherit';
    if(c.k===sortKey)btn.textContent=c.label+(sortDir===1?' ▲':' ▼');
    btn.setAttribute('aria-label','Sort by '+c.label);
    btn.addEventListener('click',()=>{
      if(sortKey===c.k)sortDir=-sortDir; else {sortKey=c.k;sortDir=c.n?1:1;}
      render();
    });
    th.appendChild(btn);htr.appendChild(th);
  });
  thead.appendChild(htr);tbl.appendChild(thead);
  const tb=el('tbody');
  rows.forEach(r=>{
    const tr=el('tr');
    cols.forEach(c=>{
      const td=el('td',c.n?'n':null);
      let v=r[c.k];
      if(c.band){const s=el('span','band '+String(v).replace(/\s/g,''),v);td.appendChild(s);}
      else if(c.bar){
        const pct=Math.max(0,Math.min(100,Number(v)));
        const bar=el('span','hbar');bar.style.width=(pct*0.55)+'px';
        td.appendChild(bar);td.appendChild(document.createTextNode(' '+pct));
      }
      else td.textContent=c.fmt?c.fmt(Number(v)):v;
      tr.appendChild(td);
    });
    tb.appendChild(tr);
  });
  tbl.appendChild(tb);
  dash.replaceChildren(tbl);
}
[...new Set(DATA.map(r=>r.csm))].sort().forEach(c=>{const o=el('option',null,c);fCsm.appendChild(o);});
[fRisk,fCsm,fQ].forEach(e=>e.addEventListener('input',render));
render();
</script>
</body>
</html>
